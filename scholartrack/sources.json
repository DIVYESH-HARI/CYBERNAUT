  {
    "source_id": "usief-fulbright-nehru",
    "name": "USIEF - Fulbright-Nehru Fellowships for Indian Citizens",
    "listing_url": "https://www.usief.org.in/fulbright-fellowships/fellowships-for-indian-citizen/",
    "adapter": "detail_pages",
    "default_timezone": "Asia/Kolkata",
    "refresh_minutes": 360,
    "enabled": true,
    "approved_by": "PENDING mentor approval - robots.txt checked 2026-10-21 (allows /)",
    "approved_at": null,
    "config": {
      "link_scope": "body",
      "link_pattern": "usief\\.org\\.in/fulbright-fellowships/fellowships-for-indian-citizen/[a-z0-9-]+/$",
      "exclude_pattern": "faqs|selection-process|fulbright-specialist|scholar-in-residence",
      "deadline_rules": [
        {"type": "table_label", "label": "application deadline"},
        {"type": "sentence", "pattern": "application deadline (?:is|:)\\s*(?P<when>[^.]+)"}
      ],
      "defaults": {
        "provider": "United States-India Educational Foundation (Fulbright)",
        "region": "Study / research in the USA",
        "residency_rule": "Indian citizens"
      }
    }
  },

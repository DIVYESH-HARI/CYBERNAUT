  "agencies": [
    {
      "key": "cmrl",
      "adapter": "cmrl",
      "operator_type": "Government",
      "enabled": true
    },
    {
      "key": "cmrl_press",
      "adapter": "cmrl_press",
      "operator_type": "Government",
      "enabled": true
    },
    {
      "key": "sample_metro",
      "adapter": "sample_metro",
      "operator_type": "Government",
      "enabled": true
    },
    {
      "key": "demo_private_bus",
      "adapter": "rss",
      "agency": "Sample Private Coaches (demo operator)",
      "operator_type": "Private",
      "url": "{demo_base_url}/demo-source/private_coaches.xml",
      "timezone": "Asia/Kolkata",
      "refresh_seconds": 300,
      "area": "Tamil Nadu intercity (demo)",
      "type_hint": "",
      "enabled": true
    },
    {
      "key": "mbta",
      "adapter": "mbta",
      "operator_type": "Government",
      "enabled": false
    }
  ]

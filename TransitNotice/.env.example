# Copy to .env (never commit .env). Values here are placeholders.
TN_DB_PATH=data/transitnotice.db
TN_ADMIN_TOKEN=change-me
TN_CONTACT=your-email@example.com
TN_SCHEDULER=1
TN_DEMO_BASE_URL=http://127.0.0.1:5000
TN_ALERT_MODE=demo
# Agencies are listed and enabled in agencies.json. Optional override of which keys run:
# TN_SOURCES=cmrl,sample_metro,demo_private_bus
TN_DISPLAY_TZ=Asia/Kolkata
# Only for TN_ALERT_MODE=smtp
TN_SMTP_HOST=
TN_SMTP_PORT=587
TN_SMTP_USER=
TN_SMTP_PASSWORD=
TN_SMTP_FROM=
